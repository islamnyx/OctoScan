APP_HOST=127.0.0.1
APP_PORT=8000
DATA_DIR=./data
NMAP_BIN=nmap
NIKTO_BIN=nikto
ZAP_BIN=/usr/share/zaproxy/zap.sh
TESTSSL_BIN=./resources/testssl.sh/testssl.sh
ZAP_PORT=8090
ZAP_API_KEY=<your-long-random-value-here>
# OOM guard: AJAX spider off by default (was spawning ~18 firefox + 4G heap).
# Enable only for JS-heavy SPAs with RAM headroom.
ZAP_ENABLE_AJAX_SPIDER=false
ZAP_AJAX_TIMEOUT_SECONDS=60
ZAP_ASCAN_RECURSE=false
ZAP_ASCAN_MAX_TARGETS=20
NUCLEI_SEVERITY=critical,high,medium,low
SCAN_TIMEOUT_SECONDS=900
SCAN_MAX_PARALLEL=1
API_KEY=
# SSRF guard: keep false in prod (blocks private/loopback/metadata targets).
# Set true only for lab scans (e.g. Juice Shop on localhost).
ALLOW_PRIVATE_TARGETS=false
SCAN_RATE_LIMIT=10
SCAN_RATE_WINDOW_S=60
# ---- Phase 2: repo / source scans ----
GIT_BIN=git
GITLEAKS_BIN=gitleaks
SEMGREP_BIN=semgrep
OSV_BIN=osv-scanner
REPO_CLONE_TIMEOUT_S=120
# ---- Phase 2: BYO AI (any OpenAI-compatible provider) ----
# Examples:
#  OpenAI:     AI_PROVIDER=openai AI_BASE_URL=https://api.openai.com/v1 AI_MODEL=gpt-4o-mini
#  Ollama:     AI_PROVIDER=ollama AI_BASE_URL=http://localhost:11434/v1 AI_MODEL=llama3.1
#  OpenRouter: AI_PROVIDER=openrouter AI_BASE_URL=https://openrouter.ai/api/v1 AI_MODEL=...
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# AI code review bounds (which/how much code the model reads)
AI_REVIEW_MAX_FILES=8
AI_REVIEW_MAX_BYTES=90000
